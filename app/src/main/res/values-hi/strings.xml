    <string name="tour_tools_title">टूल्स</string>
    <string name="tour_tools_body">कहें \"अदिति को WhatsApp पर hi भेजो\" या \"10 मिनट का टाइमर लगाओ\"। कुछ भी करने से पहले Orbit पूछता है।</string>
